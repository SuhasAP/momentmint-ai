# MOMENTMINT AI Environment Configuration
# Copy this file to .env.local and add your Google AI Studio Gemini API Key:

# Google AI Gemini API Key (Get free key from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: specify model (default: gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# Note: The application also supports setting or changing the API Key live
# inside the UI Settings dialog, and provides a polished Demo Fallback Mode
# when running without an active key so judges can test every feature instantly.
